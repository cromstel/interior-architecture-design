# Apache / LiteSpeed configuration for the static export in out/.
#
# A static export ships no server config, so the host has to be told to do two
# things this project depends on. Without them the site is measurably slower
# and every visitor re-downloads code on each visit:
#
#   1. Compress the text payloads. The homepage is ~956 KB of JS/CSS/HTML
#      uncompressed, which Brotli brings to roughly 255 KB.
#   2. Send long-lived cache headers for the fingerprinted build output.
#      Everything under _next/static/ has a content hash in its filename, so it
#      is safe to cache forever; the HTML must not be.
#
# Nothing here rewrites URLs. The export already emits trailing-slash
# directories containing index.html, which the host serves as-is.

# --- Compression -----------------------------------------------------------
# Only text formats. AVIF and WOFF2 are already compressed, so running them
# through deflate would cost CPU and save nothing.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Cache headers ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Fingerprinted build output: immutable.
  ExpiresDefault                          "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  # These carry no content hash, so they get a short TTL rather than a year.
  ExpiresByType text/plain                "access plus 1 hour"
  ExpiresByType application/xml           "access plus 1 hour"
</IfModule>

# Cache-Control to match, for proxies and browsers that ignore Expires.
<IfModule mod_headers.c>
  # Fingerprinted build output, matched on the filename rather than the path.
  #
  # Two earlier attempts used the wrong lever. `FilesMatch "^/_next/static/"`
  # matched nothing, because FilesMatch tests the basename only and no basename
  # contains a slash. `DirectoryMatch "/_next/static/"` is correct in principle
  # but is silently ignored on this host: it needs a directory-context
  # override, which a subdomain vhost rooted in a subdirectory of another domain
  # does not grant. Measured live — chunks served the host's 7-day default
  # while this very file's woff2 rule applied fine, proving mod_headers is
  # working and only the directory context was unavailable.
  #
  # So the path cannot be tested, and the hash in the name is used instead. Every
  # chunk Next emits is named `2er9am7s7p5uk.js` / `1wxykey_xr_7w.css`, and all
  # 22 js/css files in the export live under _next/static/ with no exceptions.
  #
  # The negative lookahead is load-bearing. `_buildManifest.js`,
  # `_clientMiddlewareManifest.js` and `_ssgManifest.js` are emitted under those
  # exact names on every build, so their content changes while their URL does
  # not. Marking them immutable would pin browsers to a stale build after the
  # next deploy, so anything starting with an underscore is excluded.
  <FilesMatch "^(?!_).*\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Unhashed, so not immutable. Covers robots.txt, sitemap.xml and the RSC
  # payloads that back client-side navigation.
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- MIME types ------------------------------------------------------------
# Without an explicit image/avif the host falls back to text/plain for every
# photograph. Browsers still decode them inside <img>, so the site *looks*
# right, but the wrong type also drags them into the text compression filter
# below — which re-compresses 300 KB of AVIF for nothing — and breaks direct
# navigation to an image URL.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# --- 404 -------------------------------------------------------------------
# The export emits 404.html at the root; hosts serve it for unknown paths.
# This makes that explicit and stops directory listings on a miss.
ErrorDocument 404 /404.html

Options -Indexes
